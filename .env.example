# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Session signing — generate with: openssl rand -base64 48
# Must be at least 32 characters.
SESSION_SECRET=""

# GitHub OAuth app credentials.
# Authorization callback URL must be: <NEXT_PUBLIC_SITE_URL>/api/auth/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# The single GitHub account email that gets admin (write) access.
GITHUB_ADMIN_EMAIL=""

# Cloudflare R2 (S3-compatible object storage).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
